generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PipelineProvider {
  GITHUB_ACTIONS
  JENKINS
}

enum PipelineStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum ScanTool {
  GITLEAKS
  SEMGREP
  SONARQUBE
  DEPENDENCY_CHECK
  CHECKOV
  TRIVY
}

enum ScanStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model Application {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name              String      @unique
  description       String?

  repositoryUrl     String
  defaultBranch     String      @default("main")
  language          String

  isPrivate         Boolean     @default(false)
  repositoryOwner   String?
  repositoryName    String?

  webhookEnabled    Boolean     @default(false)
  webhookSecret     String?

  scanOnPush        Boolean     @default(true)
  scanOnPullRequest Boolean     @default(true)
  autoFixEnabled    Boolean     @default(false)

  isArchived        Boolean     @default(false)

  pipelines         Pipeline[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  scanSecrets       Boolean @default(true)
  scanSast          Boolean @default(true)
  scanDependencies  Boolean @default(true)
  scanIac           Boolean @default(true)
  scanContainers    Boolean @default(true)

  @@map("applications")
  @@index([repositoryOwner])
  @@index([repositoryName])
  @@index([isArchived])
}

model GithubIntegration {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  username    String

  token        String

  isConnected Boolean @default(false)

  lastChecked DateTime?

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

  @@map("github_integrations")
}

model Pipeline {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  applicationId  String             @db.Uuid
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name           String

  provider       PipelineProvider

  runs           PipelineRun[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([applicationId])
  @@map("pipelines")
}

model PipelineRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  pipelineId     String   @db.Uuid
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  commitSha      String
  branch         String

  status         PipelineStatus

  trigger        String?
  triggeredBy    String?

  startedAt      DateTime @default(now())
  finishedAt     DateTime?

  duration       Int?

  logs           String?

  workflowRunId  String?

  scans          SecurityScan[]

  createdAt      DateTime @default(now())

  @@map("pipeline_runs")
}

model SecurityScan {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  pipelineRunId  String             @db.Uuid
  pipelineRun    PipelineRun        @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  tool           ScanTool

  status         ScanStatus

  reportPath     String?

  findings       Finding[]

  startedAt      DateTime           @default(now())

  finishedAt     DateTime?

  @@index([pipelineRunId])
  @@index([tool])
  @@map("security_scans")
}

model Finding {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  securityScanId  String           @db.Uuid
  securityScan    SecurityScan     @relation(fields: [securityScanId], references: [id], onDelete: Cascade)

  severity        Severity

  title           String

  description     String

  rule            String?

  cve             String?

  file            String?

  line            Int?

  recommendation  String?

  fixed           Boolean          @default(false)

  createdAt       DateTime         @default(now())

  @@index([securityScanId])
  @@index([severity])
  @@map("findings")
}